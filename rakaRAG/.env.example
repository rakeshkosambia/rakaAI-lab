# Copy this file to .env and fill it in. NEVER commit .env (it is in .gitignore).
# Chapters r00 to r07 and `r08_live/code.py --offline` are offline and need none of this.
# Only `r08_live/code.py --live ...` does.

# --- Provider -----------------------------------------------------------------
# The live run is built for Amazon Bedrock only.
RAKA_PROVIDER=

# --- AWS access ---------------------------------------------------------------
# Sign in BEFORE a live run (for example with your usual SSO login). Leave AWS_PROFILE empty for the default chain.
AWS_PROFILE=
AWS_REGION=

# --- Models: paste ids from YOUR account ------------------------------------------
# List what your account can call with learn-aws-bedrock/b00_setup. Nothing here is guessed for you.
# Extraction and keyword calls: a cheap, fast model (Converse API).
RAKA_EXTRACT_MODEL=
# Answers: a stronger model (Converse API).
RAKA_QUERY_MODEL=
# Embeddings: a Titan Text Embeddings or a Cohere Embed model id. A common example is amazon.titan-embed-text-v2:0,
# but confirm it is enabled for your account and Region. Keep the same model once documents are embedded.
RAKA_EMBED_MODEL=
# Vector size for Titan (256, 512 or 1024). 256 keeps it small.
RAKA_EMBED_DIMS=256

# --- Safety rail ----------------------------------------------------------------
# A hard cap on tokens (input + output, including embeddings) for the whole run. The code refuses any call that
# could push the total over this, and refuses values above 50,000 unless you change the code on purpose.
RAKA_MAX_TOTAL_TOKENS=20000
