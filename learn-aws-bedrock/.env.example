# Copy this file to .env and fill it in. NEVER commit .env (it is in .gitignore).
# Offline mode (--offline) needs none of this.

# --- AWS access -------------------------------------------------------------
# Name of a profile in your AWS config. Log in (for example with your SSO login
# method) BEFORE running a live lesson. Leave empty to use the default chain.
AWS_PROFILE=
# Region where model access is enabled for your account.
AWS_REGION=ap-southeast-1

# --- Model ------------------------------------------------------------------
# Run b00_setup (live) to list model IDs and inference profile IDs your account
# can see, then paste ONE here. Some models must be called through an inference
# profile ID instead of a plain model ID.
BEDROCK_MODEL_ID=

# --- Safety rails -----------------------------------------------------------
# Lessons stop once a run has used this many tokens (input + output).
LAB_MAX_TOTAL_TOKENS=50000
# Optional: prices per 1,000 tokens for the cost estimate in b04.
# Look up current prices yourself; the lessons do not hard-code any.
LAB_PRICE_IN_PER_1K=
LAB_PRICE_OUT_PER_1K=

# --- Optional features ------------------------------------------------------
# b04: a Bedrock Guardrail to check inputs against (leave empty to skip).
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
# b07: where skills are loaded from: local (the skills/ folder) or s3.
SKILLS_SOURCE=local
SKILLS_S3_BUCKET=
SKILLS_S3_PREFIX=skills/
# Folder the file tools may touch (default: ./workspace)
# LAB_WORKDIR=
