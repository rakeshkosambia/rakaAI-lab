# Copy this file to .env and fill it in. NEVER commit .env (it is in .gitignore).
# Chapters r00 to r07 are offline and need none of this. Only the live run (r08) does.

# Which provider the live run uses (decided later): bedrock or anthropic
RAKA_PROVIDER=
# Model for entity extraction (cheap, fast) and for answers (stronger). Paste IDs yourself.
RAKA_EXTRACT_MODEL=
RAKA_QUERY_MODEL=
# Embedding model for the live run. It must stay the same once documents are indexed.
RAKA_EMBED_MODEL=

# Safety rail: a live run stops once it has used this many tokens (input + output).
RAKA_MAX_TOTAL_TOKENS=50000
